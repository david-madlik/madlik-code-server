+ // A literal opening brace is a normal printable key.
+ if (key === '{') { text = key; }
+ if (text === undefined) { return undefined; }
+ if (ctrl && text.length === 1) {
+  const code = text.toUpperCase().charCodeAt(0);
+  if (text === ' ' || text === '@') { text = '\0'; }
+  else if (code >= 64 && code <= 95) { text = String.fromCharCode(code - 64); }
+  else if (text === '?') { text = '\x7f'; }
+ }
+ return (alt ? '\x1b' : '') + text;
+}
