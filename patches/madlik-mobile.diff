+	private readonly buttons = new Map<Section, HTMLButtonElement>();
+	private previousSidebar: string | undefined;
+	private previousPanel: string | undefined;
+
+	constructor(
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IPaneCompositePartService private readonly panes: IPaneCompositePartService,
+		@IEditorService private readonly editors: IEditorService,
+		@ICommandService private readonly commands: ICommandService,
+		@INotificationService private readonly notifications: INotificationService,
+		@IQuickInputService private readonly quickInput: IQuickInputService,
+	) {
+		super();
+		if (!isWeb) { return; }
+		this.nav.className = 'madlik-mobile-navigation';
+		this.nav.hidden = true;
+		this.nav.setAttribute('aria-label', 'Madlik mobilní navigace');
+		this.terminalKeys.className = 'madlik-mobile-terminal-keys';
+		this.terminalKeys.hidden = true;
+		this.terminalKeys.setAttribute('aria-label', 'Terminálové klávesy');
+		for (const [label, text] of [['Ctrl+C', '\u0003'], ['Esc', '\u001b'], ['Tab', '\t'], ['↑', '\u001b[A'], ['↓', '\u001b[B']]) {
+			const key = mainWindow.document.createElement('button');
+			key.type = 'button';
+			key.textContent = label;
+			this.terminalKeys.appendChild(key);
+			this._register(addDisposableListener(key, 'click', () => {
+				this.commands.executeCommand('workbench.action.terminal.sendSequence', { text }).catch(error => this.notifications.error(error));
+			}));
+		}
+		this.nav.appendChild(this.terminalKeys);
+		for (const [section, label] of [['files', 'Soubory'], ['git', 'Git'], ['editor', 'Editor'], ['terminal', 'Terminál']] as const) {
+			const button = mainWindow.document.createElement('button');
+			button.type = 'button';
+			button.textContent = label;
+			button.dataset.section = section;
+			this.nav.appendChild(button);
+			this.buttons.set(section, button);
+			this._register(addDisposableListener(button, 'click', () => this.select(section)));
+		}
+		const options = mainWindow.document.createElement('button');
+		options.type = 'button';
+		options.textContent = '⋯';
+		options.setAttribute('aria-label', 'Mobilní režim a příkazy');
+		this.nav.appendChild(options);
+		this._register(addDisposableListener(options, 'click', () => {
+			this.quickInput.pick([
+				{ label: 'Automaticky podle šířky', mode: 'auto' as const },
+				{ label: 'Mobilní režim zapnutý', mode: 'on' as const },
+				{ label: 'Vypnout mobilní režim', mode: 'off' as const },
+				{ label: 'Paleta příkazů', mode: undefined },
+			], { placeHolder: 'Madlik Mobile' }).then(item => {
+				if (item?.mode) { this.mode = item.mode; this.updateMode(); }
+				else if (item) { this.commands.executeCommand('workbench.action.showCommands'); }
+			}).catch(error => this.notifications.error(error));
+		}));
