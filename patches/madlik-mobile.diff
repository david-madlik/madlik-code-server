+import { CodeKey } from './mobileCodeKeyboard.js';
+
+/** Encode terminal input directly; synthetic DOM keyboard events are not terminal input. */
+export function terminalCodeKey({ key, ctrl, alt, shift }: CodeKey, applicationCursor: boolean): string | undefined {
+ const modifier = 1 + (shift ? 1 : 0) + (alt ? 2 : 0) + (ctrl ? 4 : 0);
+ const cursor: Record<string, string> = { '{left}': 'D', '{down}': 'B', '{up}': 'A', '{right}': 'C', '{home}': 'H', '{end}': 'F' };
+ if (cursor[key]) { return modifier > 1 ? `\x1b[1;${modifier}${cursor[key]}` : `\x1b${applicationCursor ? 'O' : '['}${cursor[key]}`; }
+ const fn = /^\{f(\d+)\}$/.exec(key);
+ if (fn) {
+  const number = Number(fn[1]);
+  if (number <= 4) { const final = 'PQRS'[number - 1]; return modifier > 1 ? `\x1b[1;${modifier}${final}` : `\x1bO${final}`; }
+  const code = [15, 17, 18, 19, 20, 21, 23, 24][number - 5];
+  return code ? `\x1b[${code}${modifier > 1 ? `;${modifier}` : ''}~` : undefined;
+ }
+ const tilde: Record<string, number> = { '{delete}': 3, '{pgup}': 5, '{pgdn}': 6 };
+ if (tilde[key]) { return `\x1b[${tilde[key]}${modifier > 1 ? `;${modifier}` : ''}~`; }
