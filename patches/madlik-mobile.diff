+		this.layoutService.mainContainer.classList.toggle('madlik-mobile', active);
+		if (active) {
+			if (!this.layoutService.isMobileLayout) {
+				this.previousSidebar = this.panes.getActivePaneComposite(ViewContainerLocation.Sidebar)?.getId();
+				this.previousPanel = this.panes.getActivePaneComposite(ViewContainerLocation.Panel)?.getId();
+			}
+			this.select('editor');
+		} else {
+			// Cancel queued mobile switches before restoring the native layout.
+			const generation = this.generation;
+			this.queue = this.queue.then(async () => {
+				if (this.active || generation !== this.generation) { return; }
+				this.switching = true;
+				try {
+					if (this.previousSidebar) { await this.panes.openPaneComposite(this.previousSidebar, ViewContainerLocation.Sidebar, false); }
+					if (this.previousPanel) { await this.panes.openPaneComposite(this.previousPanel, ViewContainerLocation.Panel, false); }
+				} finally {
+					this.layoutService.setMobileLayout(undefined);
+					this.switching = false;
+				}
+			}).catch(error => this.notifications.error(error));
+		}
+	}
+
+	private select(section: Section): void {
+		if (!this.active) { return; }
+		const generation = this.generation;
+		this.queue = this.queue.then(async () => {
+			if (!this.active || generation !== this.generation) { return; }
+			this.switching = true;
+			try {
+				this.section = section;
+				this.resize();
+				if (section === 'files' || section === 'git') {
+					await this.panes.openPaneComposite(section === 'files' ? 'workbench.view.explorer' : 'workbench.view.scm', ViewContainerLocation.Sidebar, true);
+				} else if (section === 'terminal') {
+					await this.commands.executeCommand('workbench.action.terminal.focus');
+				} else {
+					this.layoutService.focusPart(Parts.EDITOR_PART, mainWindow);
+				}
+				if (this.active && generation === this.generation) { this.resize(); }
+			} finally { this.switching = false; }
+		}).catch(error => this.notifications.error(error));
+	}
+
+	private resize(): void {
+		if (!this.active) { return; }
+		this.terminalKeys.hidden = this.section !== 'terminal';
+		for (const [section, button] of this.buttons) {
+			button.setAttribute('aria-pressed', String(section === this.section));
+		}
