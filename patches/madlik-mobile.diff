+
+import { addDisposableListener, getWindow } from './dom.js';
+import { DisposableStore, IDisposable, toDisposable } from '../common/lifecycle.js';
+
+// Window-local, transient state: never changes user settings or another client.
+class MobileKeyboard {
+	private active = false;
+	private typing = false;
+	private target: HTMLElement | undefined;
+	private readonly inputs = new Map<HTMLElement, string | null>();
+
+	register(input: HTMLElement): IDisposable {
+		this.inputs.set(input, input.getAttribute('inputmode'));
+		this.apply(input);
+		const listeners = new DisposableStore();
+		listeners.add(addDisposableListener(input, 'focus', event => {
+			this.target = input;
+			if (this.active && !this.typing) {
+				// inputmode is only a hint (notably on iOS). Reject focus as well,
+				// without changing native readonly state or cancelling scrolling.
+				event.stopImmediatePropagation();
+				input.blur();
+			}
+		}, true));
+		listeners.add(toDisposable(() => {
+			this.restore(input);
+			this.inputs.delete(input);
+			if (this.target === input) { this.target = undefined; }
+		}));
+		return listeners;
+	}
+
+	setActive(active: boolean): void {
+		this.active = active;
+		this.setTyping(false);
+	}
+
+	setTyping(typing: boolean): void {
+		this.typing = this.active && typing;
+		for (const input of this.inputs.keys()) { this.apply(input); }
+		if (this.active && !this.typing) {
+			for (const input of this.inputs.keys()) {
+				if (input.ownerDocument.activeElement === input) {
+					this.target = input;
+					input.blur();
+				}
+			}
+		}
+	}
+
+	getInputTarget(): HTMLElement | undefined { return this.target?.isConnected ? this.target : undefined; }
+
+	open(): void {
+		this.setTyping(true);
+		// Must remain synchronous inside the button's user gesture for Safari.
+		if (this.target?.isConnected) { this.target.focus({ preventScroll: true }); }
+	}
+
+	private apply(input: HTMLElement): void {
+		if (this.active && !this.typing) { input.setAttribute('inputmode', 'none'); }
+		else { this.restore(input); }
+	}
+
+	private restore(input: HTMLElement): void {
+		const original = this.inputs.get(input);
+		if (original === null) { input.removeAttribute('inputmode'); }
+		else if (original !== undefined) { input.setAttribute('inputmode', original); }
+	}
+}
+
+const keyboards = new WeakMap<Window, MobileKeyboard>();
+export function getMobileKeyboard(window: Window): MobileKeyboard {
+	let keyboard = keyboards.get(window);
+	if (!keyboard) { keyboard = new MobileKeyboard(); keyboards.set(window, keyboard); }
+	return keyboard;
+}
+
+export function registerMobileKeyboardInput(input: HTMLElement): IDisposable {
+	return getMobileKeyboard(getWindow(input)).register(input);
+}
