+		if (mainWindow.visualViewport) {
+			this._register(addDisposableListener(mainWindow.visualViewport, 'resize', () => this.resize()));
+			this._register(addDisposableListener(mainWindow.visualViewport, 'scroll', () => this.resize()));
+		}
