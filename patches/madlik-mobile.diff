@@ -0,0 +1,48 @@
+.monaco-workbench .madlik-mobile-navigation {
+	position: absolute;
+	left: 0;
+	right: 0;
+	z-index: 100;
+	display: grid;
+	grid-template-columns: repeat(4, minmax(0, 1fr)) 44px;
+	gap: 4px;
+	padding: 6px 6px calc(6px + env(safe-area-inset-bottom, 0px));
+	box-sizing: border-box;
+	background: var(--vscode-sideBar-background);
+	border-top: 1px solid var(--vscode-panel-border);
+}
+
+.monaco-workbench .madlik-mobile-navigation[hidden] { display: none; }
+
+.monaco-workbench .madlik-mobile-terminal-keys {
+	grid-column: 1 / -1;
+	display: grid;
+	grid-template-columns: repeat(5, minmax(0, 1fr));
+	gap: 4px;
+}
+
+.monaco-workbench .madlik-mobile-terminal-keys[hidden] { display: none; }
+
+.monaco-workbench .madlik-mobile-navigation button {
+	min-height: 44px;
+	min-width: 0;
+	border: 1px solid transparent;
+	border-radius: 6px;
+	font: inherit;
+	font-size: 13px;
+	color: var(--vscode-foreground);
+	background: transparent;
+	touch-action: manipulation;
+	cursor: pointer;
+}
+
+.monaco-workbench .madlik-mobile-navigation button[aria-pressed="true"] {
+	background: var(--vscode-button-background);
+	color: var(--vscode-button-foreground);
+	border-color: var(--vscode-contrastBorder, transparent);
+}
+
+.monaco-workbench .madlik-mobile-navigation button:focus-visible {
+	outline: 2px solid var(--vscode-focusBorder);
+	outline-offset: -2px;
+}
