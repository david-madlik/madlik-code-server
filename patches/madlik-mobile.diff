+type Mode = 'auto' | 'on' | 'off';
+type Section = 'files' | 'git' | 'editor' | 'terminal';
+
+class MadlikMobile extends Disposable {
+	static readonly ID = 'madlik.mobile';
+	private readonly media = mainWindow.matchMedia('(max-width: 768px)');
+	private mode: Mode = 'auto';
+	private section: Section = 'editor';
