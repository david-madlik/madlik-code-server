+		}));
+		for (const mode of ['auto', 'on', 'off'] as const) {
+			const id = `madlik.mobile.${mode}`;
+			this._register(CommandsRegistry.registerCommand(id, () => { this.mode = mode; this.updateMode(); }));
+			this._register(MenuRegistry.appendMenuItem(MenuId.CommandPalette, { command: { id, title: `Madlik Mobile: ${mode === 'auto' ? 'Automaticky' : mode === 'on' ? 'Zapnout' : 'Vypnout'}` } }));
+		}
+		for (const section of this.buttons.keys()) {
+			this._register(CommandsRegistry.registerCommand(`madlik.mobile.${section}`, () => { this.select(section); return this.queue; }));
+		}
+		this._register(toDisposable(() => { if (this.active) { this.layoutService.setMobileLayout(undefined); } }));
+		this.updateMode();
+	}
+
+	private updateMode(): void {
+		const active = this.mode === 'on' || (this.mode === 'auto' && this.media.matches);
+		if (active === this.active) { return; }
