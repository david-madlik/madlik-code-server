+/*---------------------------------------------------------------------------------------------
+ * Copyright (c) Madlik. All rights reserved.
+ * Licensed under the MIT License. See License.txt in the project root.
+ *--------------------------------------------------------------------------------------------*/
+import { createStyleSheet } from '../../../../base/browser/domStylesheets.js';
+import { setMobileFontScale } from '../../../../base/browser/mobileFontScale.js';
+import { Disposable, toDisposable } from '../../../../base/common/lifecycle.js';
+
+/** Scale absolute UI font declarations, leaving inherited/em sizes proportional.
+ * Native editor/xterm metrics use the same window-local scale separately.
+ * Styles belong to the compiled workbench contribution, with no proxy injection.
+ */
+export class MobileFonts extends Disposable {
+	private readonly style: HTMLStyleElement;
+	private active = false;
+	constructor(private readonly window: Window) {
+		super();
+		this.style = createStyleSheet(window.document.head);
+		this._register(toDisposable(() => { this.setActive(false); this.style.remove(); }));
+	}
+	setActive(active: boolean): void {
+		this.active = active;
+		if (active) { this.refresh(); }
+		this.window.document.body.classList.toggle('madlik-mobile-fonts', active);
+		setMobileFontScale(this.window, active ? 0.75 : 1);
+	}
+	refresh(): void {
+		if (!this.active) { return; }
+		const collect = (rules: CSSRuleList): string => Array.from(rules, rule => {
+			if (rule.type === 1) {
+				const styleRule = rule as CSSStyleRule;
+				const size = styleRule.style.getPropertyValue('font-size');
+				if (!/(?:px|rem|var\()/.test(size)) { return ''; }
+				const selectors = `:where(body.madlik-mobile-fonts) :is(${styleRule.selectorText})`;
+				const priority = styleRule.style.getPropertyPriority('font-size') ? ' !important' : '';
+				return `${selectors}{font-size:calc((${size}) * 0.75)${priority}}`;
+			}
+			if (rule.type === 4 || rule.type === 12) {
+				const group = rule as CSSMediaRule | CSSSupportsRule;
+				return `${rule.type === 4 ? '@media' : '@supports'} ${group.conditionText}{${collect(group.cssRules)}}`;
+			}
+			return '';
+		}).join('\n');
+		const text = Array.from(this.window.document.styleSheets, sheet => {
+			if (sheet === this.style.sheet || sheet.disabled) { return ''; }
+			try { return collect(sheet.cssRules); } catch { return ''; } // Cross-origin styles are outside our workbench.
+		}).join('\n');
+		if (text !== this.style.textContent) { this.style.textContent = text; }
+	}
+}
